# Copy to terraform.tfvars (git-ignored) and adjust. No credentials belong in this file:
# Terraform reads AWS credentials from `aws configure` / environment variables.

region             = "ap-south-1"
project_name       = "medislot"
environment        = "dev"
vpc_cidr           = "10.20.0.0/16"
az_count           = 2
single_nat_gateway = true
kubernetes_version = "1.34"

# Tighten to your public IP, e.g. ["203.0.113.10/32"]
endpoint_public_access_cidrs = ["0.0.0.0/0"]

node_instance_types = ["t3.medium"]
node_capacity_type  = "ON_DEMAND"
node_desired_size   = 3
node_min_size       = 2
node_max_size       = 4
